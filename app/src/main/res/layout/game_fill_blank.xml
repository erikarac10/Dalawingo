<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/practiceScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:gravity="center_horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <!-- Flashcard bubble -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/fbCard"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/pastel_red"
                    app:strokeWidth="4dp"
                    app:strokeColor="@android:color/transparent"
                    app:cardUseCompatPadding="true"
                    app:cardPreventCornerOverlap="false">

                    <!-- keep the padding + centering behavior from your old FrameLayout -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="20dp">

                        <com.google.android.flexbox.FlexboxLayout
                            android:id="@+id/fbPhraseRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            app:flexWrap="wrap"
                            app:alignItems="center"
                            app:justifyContent="center">

                            <TextView
                                android:id="@+id/fbCardText1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/brown"/>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center_horizontal"
                                android:layout_marginEnd="6dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/fbInput"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:minWidth="80dp"
                                    android:singleLine="true"
                                    android:gravity="center"
                                    android:inputType="textNoSuggestions|textVisiblePassword"
                                    android:imeOptions="flagNoPersonalizedLearning"
                                    android:padding="6dp"
                                    android:textColor="@color/brown"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    android:background="@drawable/fill_in_input_bg"
                                    android:cursorVisible="true"
                                    android:textCursorDrawable="@drawable/cursor_brown"/>

                                <View
                                    android:id="@+id/fbCardUnderline"
                                    android:layout_width="match_parent"
                                    android:layout_height="2dp"
                                    android:layout_marginTop="2dp"
                                    android:background="@color/brown"/>
                            </LinearLayout>

                            <TextView
                                android:id="@+id/fbCardText2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/brown"/>
                        </com.google.android.flexbox.FlexboxLayout>

                    </FrameLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- English phrase grey box -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/fbEnglishCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/pastel_grey">

                    <TextView
                        android:id="@+id/fbEnglish"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="English phrase here"
                        android:textSize="18sp"
                        android:textColor="@color/brown" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Navigation arrows and feedback row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="8dp"
                    android:paddingHorizontal="12dp">

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/fbCounter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:text="1/10"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/brown"
                            android:gravity="center_vertical" />

                    </LinearLayout>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                </LinearLayout>

                <!--
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/fbbtnResetGame"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:contentDescription="Reset game"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="20dp"
                    app:backgroundTint="@color/white"
                    app:strokeColor="@color/pastel_grey"
                    app:strokeWidth="2dp"
                    app:icon="@drawable/ic_reset"
                    app:iconTint="@color/pastel_blue"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:elevation="0dp"
                    android:visibility="gone" />
                    -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/fbbtnResetGame"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardCornerRadius="20dp"
                    app:strokeColor="@color/pastel_grey"
                    app:strokeWidth="2dp"
                    app:cardElevation="0dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@android:color/white">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="6dp"
                        android:src="@drawable/ic_reset"
                        android:contentDescription="Reset game"
                        app:tint="@color/pastel_blue" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="120dp" />

    </LinearLayout>
</ScrollView>