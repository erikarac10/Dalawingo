<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal">

        <!-- Game Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/gameCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="28dp"
            app:cardElevation="10dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Top Row: Title + Icon -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/gameCardTitleText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Game Title"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/brown"
                        android:fontFamily="sans-serif-black" />

                    <!-- Right-aligned checkbox (or icon) -->
                    <ImageView
                        android:id="@+id/gameBadge"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_box"
                        app:tint="@color/pastel_red" />
                </LinearLayout>

                <TextView
                    android:id="@+id/gameDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Best Score"
                    android:textStyle="italic"
                    android:textSize="16sp"
                    android:textColor="@color/brown"
                    android:fontFamily="sans-serif-medium" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="@color/pastel_grey" />

                <!-- Big Score Display -->
                <TextView
                    android:id="@+id/tvCounterScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="0 / 10"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="@color/pastel_red"
                    android:fontFamily="sans-serif-black"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/completedStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Incompleted"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/pastel_red"
                    android:fontFamily="sans-serif-black"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/scoreLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Best Score"
                    android:textSize="16sp"
                    android:textColor="@color/brown"
                    android:fontFamily="sans-serif-medium" />

                <!-- CTA Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="20dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlay"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Play"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        app:cornerRadius="24dp"
                        app:backgroundTint="@color/pastel_red"
                        android:layout_marginEnd="8dp" />

                    <!--
                    <Button
                        android:id="@+id/btnStats"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Stats"
                        android:textSize="18sp"
                        android:allCaps="false"
                        android:textColor="@color/pastel_red"
                        android:backgroundTint="@color/pastel_grey" />

                       -->
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
