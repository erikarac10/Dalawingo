<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Tagalog lane + fixed speaker lane -->
    <LinearLayout
        android:id="@+id/rowTagalog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <!-- Tagalog block (3 lines), centered within the space excluding speaker -->
        <LinearLayout
            android:id="@+id/tagalogBlock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/tvTagalog1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@color/brown"
                android:gravity="center"
                android:textAlignment="center"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvTagalog2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@color/brown"
                android:gravity="center"
                android:textAlignment="center"
                android:layout_marginTop="2dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvTagalog3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@color/brown"
                android:gravity="center"
                android:textAlignment="center"
                android:layout_marginTop="2dp"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- reserve speaker space even when hidden -->
        <FrameLayout
            android:id="@+id/speakerBlock"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_gravity="center_vertical">

            <ImageView
                android:id="@+id/btnSpeak"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:src="@drawable/ic_speaker"
                android:contentDescription="Speak phrase"
                app:tint="@color/brown"
                android:visibility="gone"/>
        </FrameLayout>
    </LinearLayout>

    <!-- English aligned to the same visual center as Tagalog (excluding speaker space) -->
    <LinearLayout
        android:id="@+id/englishBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingEnd="32dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvEnglish1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textStyle="italic"
            android:textColor="@color/brown"
            android:gravity="center"
            android:textAlignment="center"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvEnglish2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textStyle="italic"
            android:textColor="@color/brown"
            android:gravity="center"
            android:textAlignment="center"
            android:layout_marginTop="2dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvEnglish3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textStyle="italic"
            android:textColor="@color/brown"
            android:gravity="center"
            android:textAlignment="center"
            android:layout_marginTop="2dp"
            android:visibility="gone"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/explainBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingEnd="32dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvExplain1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textColor="@color/brown"
            android:gravity="start"
            android:textAlignment="textStart"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvExplain2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textColor="@color/brown"
            android:gravity="center"
            android:textAlignment="center"
            android:layout_marginTop="2dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvExplain3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textColor="@color/brown"
            android:gravity="center"
            android:textAlignment="center"
            android:layout_marginTop="2dp"
            android:visibility="gone"
            />
    </LinearLayout>

</LinearLayout>
