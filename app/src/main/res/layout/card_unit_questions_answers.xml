<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/questionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Question Text Here"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/brown"
            android:fontFamily="sans-serif-black" />

        <!-- Input field -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tiInputCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/white"
            app:strokeWidth="2dp"
            app:strokeColor="@color/pastel_grey">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/UnitQuestionInput"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:gravity="top|start"
                android:padding="16dp"
                android:hint="Enter your answer here"
                android:textSize="20sp"
                android:textColor="@color/brown"
                android:background="@android:color/transparent"
                android:inputType="textCapSentences|textMultiLine"
                android:textCursorDrawable="@drawable/cursor_brown"/>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnSubmitAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submit"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/pastel_red"
            android:layout_marginBottom="16dp"/>
    </LinearLayout>
</ScrollView>